# ERMS web UI: serves the single-page app and forwards its calls, so the browser talks to ONE origin
# (no CORS, no passwords in the browser). ${VARS} are filled in from the environment when the container starts
# (official nginx image: /etc/nginx/templates/*.template -> envsubst).
#
#   /api/...     -> request-service    the whole client API (create, read, update, match, list, summary)
#   /coord/...   -> coordinator        READ-ONLY: cluster view, shard lookup (no writes to storage from a browser)
#   /prom/...    -> Prometheus         queries + scrape targets only
#
# Service names are re-resolved every 10 s, so a restarted container / recreated pod (new IP) is found again.

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 64k;

    # Deployment-specific settings for the app (ports of Grafana etc. as seen from the browser)
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"platform":"${ERMS_PLATFORM}","grafanaPort":"${GRAFANA_PORT}","prometheusPort":"${PROMETHEUS_PORT}","rabbitPort":"${RABBIT_PORT}","apiPort":"${API_PORT}","coordinatorPort":"${COORD_PORT}"}';
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # Client API (request-service)
    location /api/ {
        set $erms_api http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $erms_api;
        proxy_read_timeout 60s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Storage coordinator, read-only
    location /coord/ {
        limit_except GET { deny all; }
        set $erms_coord http://${COORD_UPSTREAM};
        rewrite ^/coord/(.*)$ /$1 break;
        proxy_pass $erms_coord;
    }

    # Prometheus: only queries and the scrape-target list
    location ~ ^/prom/api/v1/(query|query_range|targets)$ {
        limit_except GET { deny all; }
        set $erms_prom http://${PROM_UPSTREAM};
        rewrite ^/prom/(.*)$ /$1 break;
        proxy_pass $erms_prom;
    }
    location /prom/ {
        return 403;
    }

    # The app itself (static files); unknown paths fall back to the app
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
