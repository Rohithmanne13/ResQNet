    {
      "id": 11,
      "type": "timeseries",
      "title": "RabbitMQ queue depth",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=\"matching.requests\"})",
          "legendFormat": "waiting (matching.requests)",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rabbitmq_detailed_queue_messages_unacked{queue=\"matching.requests\"})",
          "legendFormat": "being processed (unacked)",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=\"matching.retry\"})",
          "legendFormat": "delayed retry (matching.retry)",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
